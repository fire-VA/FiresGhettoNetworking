    <!--
      Public-test build toggle.
      Default flipped to `true` on 2026-05-11 when the HintPath'd
      assembly_valheim_publicized.dll (Steam install path) was refreshed against
      the upcoming public-test build. With the publicized DLL now exposing
      Vector2s-style ZoneSystem.GetZone and the new ZDOExtraData internals,
      the live-build (#else) code path no longer compiles — Vector2i ↔ Vector2s
      mismatches and missing ZDOExtraData.Get*/GetSave* methods are the
      expected failure mode if you try to build with this back to `false`.

      To return to live-build compilation: regenerate
      assembly_valheim_publicized.dll from a live assembly_valheim.dll AND
      flip this default back to `false`. Don't do one without the other.

      Override at the command line with: msbuild /p:PublicTest=false
      The conditional <DefineConstants> append lives BELOW the Debug/Release
      groups so it post-extends whatever DefineConstants those set.
    -->
    <PublicTest Condition=" '$(PublicTest)' == '' ">false</PublicTest>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!--
    Append PUBLIC_TEST to DefineConstants when the toggle is on. Placed AFTER
    the Debug/Release groups so $(DefineConstants) already holds DEBUG;TRACE
    (or TRACE) — the append produces DEBUG;TRACE;PUBLIC_TEST without losing
    the configuration-specific symbols. Toggle by setting <PublicTest>true</PublicTest>
    in the top property group, or pass /p:PublicTest=true at the msbuild CLI.
  -->
  <PropertyGroup Condition=" '$(PublicTest)' == 'true' ">
    <DefineConstants>$(DefineConstants);PUBLIC_TEST</DefineConstants>
  </PropertyGroup>
